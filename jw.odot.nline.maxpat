					"text" : "/nline ??= [0.0, 0.0, 1000],\n/nline = float32(/nline),\n/n ??= 1,\n/len = length(/nline),\nif(/len == /n, progn(/a = /b = /nline, /t=0),\n if(/len == 2*/n + 1, \n  progn(/a=/nline[[aseq(0,/n-1,1)]],/b=/nline[[aseq(/n,2*/n-1,1)]], /t=/nline[[2*/n]]),\n  if(/len == /n+1, \n    progn(/a=/nline[[aseq(0,/n-1,1)]], /t=/nline[[/n]]), \n    /error = \"Invalid Input: list length is neither n+1 nor 2n+1\"\n  )\n )\n)\n"
